   "caveats": [
    "row_no is the position of the process row in the customer Excel (41 rows of the KPI 1 design); a row without a process code is all 0.",
    "per_day = quantity / CALENDAR days of the month (the current month stays low until it ends); per_hour = quantity / hours of the same sheets.",
    "Not company-aware."
   ],
   "column_groups": {
