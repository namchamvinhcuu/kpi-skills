  "month_metric": {
   "caveats": [
    "Confirmed production sheets of every MMS process, by actual_date; working_days counts days with a confirmed sheet of the process with code 022 and quantity above 0.",
    "regular_hours = sum of end_time - start_time (parallel workers add up); ng_qty and actual_qty cover ALL processes.",
    "Not company-aware."
   ],
   "column_groups": {
    "months": [
     "month_1",
     "month_2",
     "month_3",
     "month_4",
     "month_5",
     "month_6",
     "month_7",
     "month_8",
     "month_9",
     "month_10",
     "month_11",
     "month_12"
    ]
   },
