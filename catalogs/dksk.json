  "qms_history": {
   "caveats": [
    "One table holds IQC, PQC and OQC: pick the form type with `where`; the month is the check date (Datetime).",
    "IQC rows only carry `qty` (no sample quantity): do not divide ng_qty by qty for IQC without asking the owner.",
    "overall_result is free text (OK, Pass, NG, Fail): use `filter` with the listed values only.",
    "The Year filter does not change a pivot read: the year is taken from the filter through a hidden probe, so with a year that has no data every pivot cell shows 0, also the previous-year ones.",
    "Customer is only reachable through the product's buyer: not available here."
   ],
   "date_field": "check_date",
   "kind": "pivot",
   "measures": [
    "__count",
    "qty",
    "insp_qty_sampling",
    "ng_qty",
    "ok_lot_qty",
    "ng_lot_qty"
   ],
   "model": "mes.qc_form.history",
   "optional_filters": {
    "overall_result": {
     "values": [
      "OK",
      "Pass",
      "NG",
      "Fail"
     ]
    }
   },
   "read_audience": "base.group_user",
   "selectors": {
    "form_type": {
     "values": [
      "iqc",
      "pqc",
      "oqc",
      "iqc_outsourcing",
      "item_qc",
      "re_use"
     ]
    }
   },
   "title": "QMS check history: forms counted or summed per month",
   "unit": "forms (__count) or pcs"
  },
